{
  "name": "auvora-finance",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "deploy:testnet": "node --env-file=.env.deploy.local scripts/deploy-testnet.mjs",
    "upgrade:phase1:testnet": "node --env-file=.env.deploy.local scripts/upgrade-phase1-testnet.mjs",
    "upgrade:phase2:testnet": "node --env-file=.env.deploy.local scripts/upgrade-phase2-testnet.mjs",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "provision:keeper-key": "node --env-file=.env.keeper.local scripts/provision-keeper-key.mjs",
    "proof:relayer": "node --env-file=.env.relayer.local scripts/prove-relayer-testnet.mjs",
    "proof:phase1": "node --env-file=.env.deploy.local scripts/prove-phase1-testnet.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "near-api-js": "7.3.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
