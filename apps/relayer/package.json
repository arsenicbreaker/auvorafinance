{
  "name": "@auvora/relayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env.relayer.local --import tsx src/server.ts",
    "db:migrate": "node --env-file=../../.env.relayer.local --import tsx src/server.ts --migrate",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auvora/config": "workspace:*",
    "near-api-js": "7.3.1",
    "near-kit": "0.20.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.15.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
