generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TransactionFinalState {
  Pending
  Success
  Failed
}

enum ExecutionRecordStatus {
  Pending
  Succeeded
  Failed
  Skipped
  Ignored
}

model WorkflowSnapshot {
  network         String   @map("network")
  contractId      String   @map("contract_id")
  workflowId      BigInt   @map("workflow_id")
  ownerId         String   @map("owner_id")
  recipientId     String   @map("recipient_id")
  amountYocto     String   @map("amount_yocto")
  minReserveYocto String   @map("min_reserve_yocto")
  availableYocto  String   @map("available_yocto")
  intervalMs      BigInt   @map("interval_ms")
  nextRunAtMs     BigInt   @map("next_run_at_ms")
  maxRuns         Int      @map("max_runs")
  runsCompleted   Int      @map("runs_completed")
  state           String   @map("state")
  pendingRunIndex Int?     @map("pending_run_index")
  observedAt      DateTime @map("observed_at") @db.Timestamptz(3)

  @@id([network, contractId, workflowId])
  @@index([network, contractId, state, nextRunAtMs], map: "workflow_snapshot_due_idx")
  @@map("workflow_snapshot")
}

model Execution {
  network         String                @map("network")
  contractId      String                @map("contract_id")
  workflowId      BigInt                @map("workflow_id")
  runIndex        Int                   @map("run_index")
  scheduledForMs  BigInt                @map("scheduled_for_ms")
  amountYocto     String                @map("amount_yocto")
  status          ExecutionRecordStatus @map("status")
  reasonCode      String?               @map("reason_code")
  transactionHash String?               @map("transaction_hash")
  dispatchedAt    DateTime?             @map("dispatched_at") @db.Timestamptz(3)
  finalizedAt     DateTime?             @map("finalized_at") @db.Timestamptz(3)

  @@id([network, contractId, workflowId, runIndex])
  @@index([transactionHash], map: "execution_transaction_hash_idx")
  @@map("execution")
}

model KeeperLease {
  network    String   @map("network")
  contractId String   @map("contract_id")
  workflowId BigInt   @map("workflow_id")
  holderId   String   @map("holder_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  acquiredAt DateTime @map("acquired_at") @db.Timestamptz(3)

  @@id([network, contractId, workflowId])
  @@index([expiresAt], map: "keeper_lease_expires_at_idx")
  @@map("keeper_lease")
}

model SubmittedTransaction {
  network         String                @map("network")
  transactionHash String                @map("transaction_hash")
  contractId      String                @map("contract_id")
  workflowId      BigInt                @map("workflow_id")
  runIndex        Int                   @map("run_index")
  scheduledForMs  BigInt                @map("scheduled_for_ms")
  amountYocto     String                @map("amount_yocto")
  signerId        String                @map("signer_id")
  method          String                @map("method")
  submittedAt     DateTime              @map("submitted_at") @db.Timestamptz(3)
  finalState      TransactionFinalState @map("final_state")
  errorCode       String?               @map("error_code")
  finalizedAt     DateTime?             @map("finalized_at") @db.Timestamptz(3)

  @@id([network, transactionHash])
  @@index([network, contractId, workflowId, runIndex, finalState], map: "submitted_transaction_workflow_idx")
  @@map("submitted_transaction")
}

model ServiceHeartbeat {
  serviceId            String    @id @map("service_id")
  network              String    @map("network")
  version              String    @map("version")
  lastPollStartedAt    DateTime  @map("last_poll_started_at") @db.Timestamptz(3)
  lastSuccessfulPollAt DateTime? @map("last_successful_poll_at") @db.Timestamptz(3)
  lastErrorCode        String?   @map("last_error_code")
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([network, lastSuccessfulPollAt], map: "service_heartbeat_network_success_idx")
  @@map("service_heartbeat")
}
