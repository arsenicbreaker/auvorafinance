{
  "name": "@auvora/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./history": {
      "types": "./src/history.ts",
      "default": "./dist/history.js"
    }
  },
  "scripts": {
    "build": "prisma generate --config prisma7.config.ts && tsc -p tsconfig.json",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "prisma generate --config prisma7.config.ts && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.15.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
